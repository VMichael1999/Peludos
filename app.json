{
  "expo": {
    "name": "Peludos",
    "slug": "peludos",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F4FA3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "peludos",
    "extra": {
      "router": {
        "root": "src/app"
      }
    },
    "plugins": [
      "@ng-native/metro",
      "expo-font",
      "expo-secure-store",
      "expo-maps",
      ["expo-build-properties", { "ios": { "deploymentTarget": "18.0" } }],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Peludos usa tu ubicación para mostrarte las veterinarias y tiendas más cercanas y avisarte de mascotas perdidas cerca."
        }
      ]
    ]
  }
}
