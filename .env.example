# Copy this file to .env and fill in your own key. Never commit .env.
GOOGLE_MAPS_API_KEY=
# Optional: free key from https://www.pexels.com/api/ . Without it the reels keep their placeholders.
PEXELS_API_KEY=

# Optional: free key from https://pixabay.com/api/docs/ . Without it the reels show sample reels with no video.
PIXABAY_API_KEY=
